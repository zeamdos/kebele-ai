# Flip the global switch once real keys are available.
# Every provider still has a per-service override and will stay in mock
# mode if its credentials are missing.
USE_REAL_APIS=false

# Per-provider overrides (optional): true|false
# USE_REAL_ADDIS_AI=
# USE_REAL_WHISPERFLOW=
# USE_REAL_ELEVENLABS=
# USE_REAL_OCR=
# USE_REAL_TELEBIRR=
# USE_REAL_SMS=
# USE_REAL_SUPABASE=

# Addis AI
ADDIS_AI_API_KEY=
ADDIS_AI_BASE_URL=https://api.addisai.com/v1
ADDIS_AI_MODEL=addis-am-instruct

# Whisperflow STT
WHISPERFLOW_API_KEY=
WHISPERFLOW_BASE_URL=https://api.whisperflow.ai/v1

# ElevenLabs TTS
ELEVENLABS_API_KEY=
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Google Cloud Vision OCR (+ Tesseract fallback)
GOOGLE_VISION_API_KEY=
GOOGLE_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
OCR_TESSERACT_FALLBACK=true
TESSERACT_LANGUAGES=amh+eng

# Telebirr
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=
TELEBIRR_BASE_URL=https://api.ethiotelecom.et/v1
TELEBIRR_NOTIFY_URL=
TELEBIRR_RETURN_URL=

# Africa's Talking SMS
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_SENDER_ID=
AFRICAS_TALKING_BASE_URL=https://api.africastalking.com/version1

# Supabase (auth/db/storage when live)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=kebele-files

# Local mock persistence
KN_STORAGE_DIR=.data/storage
KN_DB_FILE=.data/db.json

# Pricing (ETB)
PRICE_FORM_FILL_BIRR=75
PRICE_ERRAND_PLATFORM_FEE_BIRR=25
